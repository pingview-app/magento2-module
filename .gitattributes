# Normalise line endings in the repository regardless of the contributor's
# platform. The blobs are already LF; this stops a clone without core.autocrlf
# from committing a whole file back as CRLF.
* text=auto

# Keep development-only files out of the Composer dist archive that lands in
# every store's vendor/ directory. They stay in the repository. GitHub applies
# these rules to the zipball Composer downloads, so this list is the single
# definition of "what a store receives" - build-module-zip.ps1 goes through
# git archive rather than repeating it.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.github         export-ignore
/AGENTS.md       export-ignore
/CAPABILITIES.md export-ignore
/PUBLISHING.md   export-ignore
/Test            export-ignore
/build-module-zip.ps1 export-ignore
